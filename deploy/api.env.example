# Environment for the BunBench API container (copy to api.env; never commit api.env).

# REQUIRED. Random secret (>= 32 chars) for starting/cancelling/deleting runs and changing settings.
# Generate with:  openssl rand -hex 32   or   bun -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
BUNBENCH_API_TOKEN=replace-with-a-long-random-secret

# REQUIRED. The exact origin of the Vercel frontend (scheme + host, no trailing slash).
# Add your custom domain too if you use one, comma-separated.
BUNBENCH_CORS_ORIGINS=https://your-project.vercel.app

# Optional tuning.
BUNBENCH_RATE_LIMIT_PER_MINUTE=12
# Optional: pin specific runtimes (absolute paths inside the container).
# BUNBENCH_NODE_PATH=/usr/local/bin/node
# BUNBENCH_BUN_PATH=/usr/local/bin/bun
