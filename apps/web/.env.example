# Build-time configuration for the frontend (Vite exposes VITE_* variables to the browser bundle;
# never put secrets here).

# URL of the BunBench API server, without a trailing slash and without /api.
# Leave empty for local development (the Vite dev server proxies /api to 127.0.0.1:3001)
# and when the API serves the frontend itself (`bun run start`).
# On Vercel set it in Project Settings → Environment Variables, e.g. https://api.your-domain.example
VITE_API_BASE=
