# Copy to .env and adjust. Bun loads .env automatically.

# API server bind address and port. Keep 127.0.0.1 unless you have read docs/security.md.
BUNBENCH_HOST=127.0.0.1
BUNBENCH_PORT=3001

# Comma-separated list of browser origins allowed by CORS (the Vite dev server by default).
BUNBENCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SQLite database file (relative paths resolve from the repository root).
BUNBENCH_DB_PATH=data/bunbench.sqlite

# Optional absolute paths to the runtimes under test. When unset, BunBench uses the Bun
# executable running the API and the first `node` found on PATH. These are operator-only
# settings: the HTTP API can never change which executable is launched.
# BUNBENCH_BUN_PATH=
# BUNBENCH_NODE_PATH=

# Benchmark creation rate limit (requests per minute per client address).
BUNBENCH_RATE_LIMIT_PER_MINUTE=12

# Show runtime executable paths in the UI (home directory is always redacted to ~).
BUNBENCH_EXPOSE_PATHS=true
